# glibc caches joined threads' stacks and TLS (dtv) blocks for reuse; the
# cache holds interior pointers, so memcheck classifies them "possibly lost"
# even after every pthread_join succeeded.  This is allocator behavior, not an
# MSC leak -- suppress it so `make valgrind` stays a strict pass/fail gate.
{
   glibc-cached-thread-tls-dtv
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   ...
   fun:_dl_allocate_tls
   ...
   fun:pthread_create*
}

# glibc's timed-wait implementation can emit an internal replacement signal
# after releasing the application mutex. Helgrind 3.22 mistakes that internal
# signal for an application call. Match ONLY its immediate libc wait frames,
# not MSC's signal sites, and never suppress Helgrind:Race reports.
{
   glibc-timedwait-internal-replacement-signal
   Helgrind:Dubious
   obj:*/vgpreload_helgrind-*.so
   fun:__pthread_cond_wait_common
   fun:pthread_cond_timedwait*
}
{
   glibc-timedwait-internal-signal-other-lock-owner
   Helgrind:Misc
   obj:*/vgpreload_helgrind-*.so
   fun:__pthread_cond_wait_common
   fun:pthread_cond_timedwait*
}
